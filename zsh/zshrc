# zshrc is only sourced for interactive shells
#
# initialize pretty prompt with starship
eval "$(starship init zsh)"
# initialize direnv
eval "$(direnv hook zsh)"
# initialize zim (package manager for zsh)
source ${ZSHCONFIG}/zim/init.zsh
# Vite+ bin (https://viteplus.dev)
. "$HOME/.config/vite-plus/env"

alias vi=nvim

function vic {
  cd ~/.config && vi
}

export FZF_ALT_C_COMMAND='fd --type d . $HOME'
bindkey '\ex' fzf-cd-widget

bindkey -s '^g' '^ugit_checkout_fzf^M'

# include ~/.local/zshrc, so that the environment can be extended with sensitive information locally
source ~/.local/zshrc

# opencode (TODO: remove this once opencode2 get's out of beta & go back to using homebrew for opencode)
export PATH=/Users/theosteiner/.opencode/bin:$PATH
